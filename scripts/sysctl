#!/bin/sh
# sysctl.d in Void's order, then /etc/sysctl.conf. From void-runit core-services/08-sysctl.sh.
. /usr/lib/dinit/functions
command -v sysctl >/dev/null || exit 0
msg "Loading sysctl(8) settings..."
mkdir -p /run/vsysctl.d
for i in /run/sysctl.d/*.conf /etc/sysctl.d/*.conf /usr/local/lib/sysctl.d/*.conf /usr/lib/sysctl.d/*.conf; do
	if [ -e "$i" ] && [ ! -e "/run/vsysctl.d/${i##*/}" ]; then
		ln -s "$i" "/run/vsysctl.d/${i##*/}"
	fi
done
for i in /run/vsysctl.d/*.conf; do
	[ -e "$i" ] && sysctl -p "$i"
done
rm -rf -- /run/vsysctl.d
[ -e /etc/sysctl.conf ] && sysctl -p /etc/sysctl.conf
exit 0
