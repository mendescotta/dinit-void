# Shared by the dinit-void boot scripts. From void-runit's functions (public domain): messages,
# container detection, and Void's /etc/rc.conf, which every boot step reads like runit's stage 1 does.
# A step that fails exits non-zero; dinit then offers the `recovery` service (sulogin) like
# void-runit's emergency_shell.
PATH=/usr/bin:/usr/sbin
export PATH

msg() { printf '\033[1m=> %s\033[m\n' "$*"; }
msg_warn() { printf '\033[1m\033[33mWARNING: %s\033[m\n' "$*"; }
fail() { printf '\033[1m\033[31mERROR: %s\033[m\n' "$*"; exit 1; }

detect_container() {
	# LXC, podman
	[ -z "${container+x}" ] || export IS_CONTAINER=1
	[ -e /.dockerenv ] && export IS_CONTAINER=1
	[ -n "$IS_CONTAINER" ] && export VIRTUALIZATION=1
	return 0
}

# the root of a live image (dracut's overlay over squashfs) is never checked or remounted
root_is_live() {
	case "$(findmnt -n -o FSTYPE /)" in overlay | squashfs) return 0 ;; esac
	return 1
}

detect_container
[ -r /etc/rc.conf ] && . /etc/rc.conf
