#!/bin/sh
# utmp, the boot wtmp record, loopback, hostname, timezone. From void-runit core-services/05-misc.sh.
. /usr/lib/dinit/functions
install -m0664 -o root -g utmp /dev/null /run/utmp
/usr/lib/dinit/halt -B # wtmp boot record
msg "Setting up loopback interface..."
ip link set up dev lo
[ -r /etc/hostname ] && read -r HOSTNAME < /etc/hostname
if [ -n "$HOSTNAME" ]; then
	msg "Setting up hostname to '$HOSTNAME'..."
	printf '%s' "$HOSTNAME" > /proc/sys/kernel/hostname
else
	msg_warn "Didn't setup a hostname!"
fi
if [ -n "$TIMEZONE" ]; then
	msg "Setting up timezone to '$TIMEZONE'..."
	ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
fi
exit 0
